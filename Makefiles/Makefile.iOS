#
# Makefile.iOS
#
# Cross-build of the *libretro core only* for aarch64-apple-ios.
#
#   make -f Makefiles/Makefile.iOS LIBRETRO=1
#
# There is no iOS host build: iOS has no SDL2, no GLUT, no Cocoa and no
# OpenGL.framework, so Src/OSD/SDL/Main.cpp cannot be built and the LIBRETRO=1
# path is the only supported one. The makefile refuses a non-libretro build
# rather than emitting a confusing wall of errors.
#
# Output goes to lib-ios/ / obj-ios/ so it never collides with the macOS build.
#


ifneq ($(strip $(LIBRETRO)),1)
$(error Makefile.iOS builds the libretro core only. Pass LIBRETRO=1.)
endif


###############################################################################
# Build Options
###############################################################################

DELETE = rm -d -r -f

#
# Suffix appended to obj/, bin/ and lib/ by Rules.inc, so an iOS build and a
# macOS build can coexist in one checkout.
#
BITS = -ios


###############################################################################
# Release Package Options
###############################################################################

PKG_TYPE = tgz
PKG_FILES =


###############################################################################
# Platform Configuration
###############################################################################

#
# Must be included first
#
include Makefiles/Options.inc

#
# SDK / deployment target
#
IOS_SDK = iphoneos
IOS_MIN_VERSION = 17.0
IOS_ARCH = arm64
IOS_SYSROOT := $(shell xcrun --sdk $(IOS_SDK) --show-sdk-path)

ifeq ($(strip $(IOS_SYSROOT)),)
$(error Could not locate the $(IOS_SDK) SDK. Is Xcode installed and selected?)
endif

#
# Toolchain (target)
#
CC  = xcrun -sdk $(IOS_SDK) clang
CXX = xcrun -sdk $(IOS_SDK) clang
LD  = xcrun -sdk $(IOS_SDK) clang

PLATFORM_ARCH = -arch $(IOS_ARCH) -isysroot $(IOS_SYSROOT) -mios-version-min=$(IOS_MIN_VERSION)

#
# Toolchain (host) -- m68kmake is a build-time code generator and must run on
# the build machine, not on the phone.
#
HOST_CC = clang
HOST_LD = clang
HOST_CFLAGS = -c -O2 -w -std=iso9899:2011


###############################################################################
# GL seam
#
# THIS IS THE ONLY PLACE THE GRAPHICS API IS CHOSEN.
#
# GLEW is built with -DGLEW_LIBRETRO, so every GL entry point from GL 1.2
# onwards is a function pointer resolved at run time through
# RetroArchGetProcAddress -- those cost nothing at link time. What *is* linked
# directly is the GL 1.1 core (glClear, glDrawArrays, glTexImage2D, ...).
# Satisfying that set is the ENTIRE GL link dependency of this core, and it is
# what these two variables supply. Nothing else in the build names a graphics
# API.
#
# Measured (Xcode 16 / iPhoneOS18.5 SDK, this source tree):
#   * With the Legacy3D translation units excluded (see EXCLUDE_SRC_FILES) the
#     core needs exactly 27 directly-linked GL entry points.
#   * 25 of the 27 are core OpenGL ES 3.0, verified by name against
#     $(SDK)/System/Library/Frameworks/OpenGLES.framework/Headers/ES3/gl.h.
#   * The 2 that are not are glClearDepth (New3D::CNew3D::RenderFrame and
#     retro_context_reset) and glDrawBuffer (3 sites in LibRetro.cpp). Both have
#     ES 3.0 spellings -- glClearDepthf and glDrawBuffers -- so the remaining
#     work is a source change, not a linkage question. That change is SM-04's,
#     not this makefile's, so it is NOT made here and the link is left honest.
#   * gluPerspective, the one GLU call, is used only by Legacy3D and therefore
#     disappears with it.
#
#   none    (default) -- link with no GL provider at all, which fails with all
#                        27 names. Nothing is stubbed and nothing is hidden.
#   eagl              -- the iOS system GLES: -framework OpenGLES. Resolves 25
#                        of 27; the link then names exactly glClearDepth and
#                        glDrawBuffer.
#   angle             -- a vendored ANGLE libGLESv2; set ANGLE_LIB_DIR.
#
# SM-04 branch C (New3D ported to Vulkan) removes the seam rather than adding
# another arm to it.
###############################################################################

GL_BACKEND ?= none

ifeq ($(strip $(GL_BACKEND)),none)
PLATFORM_GL_CXXFLAGS =
PLATFORM_GL_LDFLAGS =
else ifeq ($(strip $(GL_BACKEND)),eagl)
PLATFORM_GL_CXXFLAGS =
PLATFORM_GL_LDFLAGS = -framework OpenGLES
else ifeq ($(strip $(GL_BACKEND)),angle)
PLATFORM_GL_CXXFLAGS =
PLATFORM_GL_LDFLAGS = -L$(ANGLE_LIB_DIR) -lGLESv2 -lEGL
else
$(error Unknown GL_BACKEND "$(GL_BACKEND)" (expected: none, eagl, angle))
endif


###############################################################################
# iOS-specific flags
###############################################################################

#
# SUPERMODEL_OSX is deliberately NOT defined: it makes Src/OSD/SDL/SDLIncludes.h
# reach for <SDL2/SDL.h> and <SDL2_net/SDL_net.h>, i.e. the macOS frameworks.
# Undefined, it asks for <SDL.h> / <SDL_net.h>, which -ISrc/OSD/iOS/include
# answers with the shims described in Src/OSD/iOS/iOSStubs.cpp.
#
PLATFORM_CXXFLAGS = -DSUPERMODEL_IOS -ISrc/OSD/iOS/include $(PLATFORM_GL_CXXFLAGS)
PLATFORM_LDFLAGS = $(PLATFORM_ARCH) $(PLATFORM_GL_LDFLAGS) -lz -lm -lc++ \
	-Wl,-rpath,@executable_path/Frameworks -Wl,-rpath,@loader_path
PLATFORM_DIRS =
PLATFORM_BINARY_EXTENSION =
PLATFORM_DYLIB_EXTENSION = .dylib
PLATFORM_DYLIB_FLAG = -dynamiclib -install_name @rpath/$(SUPERMODEL_DYLIB)

PLATFORM_SRC_FILES = \
	Src/OSD/OSX/FileSystemPath.cpp \
	Src/OSD/iOS/iOSStubs.cpp \
	Src/OSD/iOS/iOSOSD.cpp


###############################################################################
# Sources that cannot be built for iOS
#
# Every entry here is either (a) unreachable from the libretro entry points, or
# (b) reachable only through a code path the libretro core disables.
#
# Measured, not assumed: with these removed and nothing put back, the link named
# exactly four non-GL symbols -- BeginFrameVideo, EndFrameVideo,
# SetAudioCallback and CCrosshair's four members. The six imgui units,
# Gui.cpp, SDLInputSystem.cpp and NetOutputs.cpp contributed *none*, which is
# the proof that they were only ever compiled in and never reached. The four
# that were reached are defined in Src/OSD/iOS/iOSOSD.cpp, with the reasoning
# per function written down there.
#
# The SDL2_net netboard is deliberately NOT here. Src/Model3/Model3.cpp
# constructs a CSimNetBoard unconditionally, so dropping Src/Network/ would need
# a source change; instead Src/OSD/iOS/include/SDL_net.h + iOSStubs.cpp give the
# four network units something to link against. Nothing calls it: LibRetro.cpp
# sets Network=false, so CSimNetBoard::Init returns before opening a socket and
# CModel3::m_runNetBoard stays false -- including for spikeofe, whose
# Config/Games.xml entry does declare <netboard>true</netboard>.
###############################################################################

EXCLUDE_SRC_FILES = \
	Src/OSD/SDL/Main.cpp \
	Src/OSD/SDL/Audio.cpp \
	Src/OSD/SDL/Gui.cpp \
	Src/OSD/SDL/SDLInputSystem.cpp \
	Src/OSD/SDL/Crosshair.cpp \
	Src/OSD/SDL/NetOutputs.cpp \
	Src/Pkgs/imgui/imgui.cpp \
	Src/Pkgs/imgui/imgui_draw.cpp \
	Src/Pkgs/imgui/imgui_impl_sdl2.cpp \
	Src/Pkgs/imgui/imgui_impl_opengl3.cpp \
	Src/Pkgs/imgui/imgui_tables.cpp \
	Src/Pkgs/imgui/imgui_widgets.cpp \
	Src/Graphics/Legacy3D/Legacy3D.cpp \
	Src/Graphics/Legacy3D/Models.cpp \
	Src/Graphics/Legacy3D/TextureRefs.cpp


###############################################################################
# Core Makefile
###############################################################################

include Makefiles/Rules.inc

# -s (strip) is obsolete and ignored by Apple ld64
LDOPT := $(filter-out -s,$(LDOPT))


clean:
	$(SILENT)echo Cleaning up \"$(BIN_DIR)\", \"$(LIB_DIR)\" and \"$(OBJ_DIR)\"...
	$(SILENT)$(DELETE) $(BIN_DIR)
	$(SILENT)$(DELETE) $(LIB_DIR)
	$(SILENT)$(DELETE) $(OBJ_DIR)
